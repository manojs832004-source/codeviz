const fs = require('fs');
const path = require('path');
const BASE = 'E:\\visualization code project\\frontend';

function w(relPath, content) {
  const full = path.join(BASE, relPath);
  fs.mkdirSync(path.dirname(full), { recursive: true });
  fs.writeFileSync(full, content.trim() + '\n');
  console.log('  wrote', relPath);
}

// ═══════════════════════════════════════════════════════════════
// 1. STEP INSPECTOR — The new main visualization panel
// ═══════════════════════════════════════════════════════════════
w('src/components/StepInspector.tsx', `'use client';

import React, { useMemo } from 'react';
import { motion, AnimatePresence } from 'framer-motion';

// ─── Types ───
interface StackEntry { funcName: string; localVars: Record<string, any>; line: number; }
interface HeapNode { type: string; value?: any; items?: any[]; fields?: Record<string, any>; pointsTo?: string; }
interface StateFrame { step: number; line: number; stack: StackEntry[]; heap: Record<string, HeapNode>; stdout: string; }

interface StepInspectorProps {
  frame: StateFrame;
  prevFrame: StateFrame | null;
  code: string;
  totalSteps: number;
}

// Known index variable names
const INDEX_NAMES = new Set([
  'i','j','k','l','m','n','left','right','mid','lo','hi',
  'start','end','low','high','min_index','max_index','minIdx','maxIdx',
  'pivot','p','q','r','idx','index','pos','temp_idx','gap',
  'min_idx','max_idx','first','last','begin','top','bottom',
]);

export default function StepInspector({ frame, prevFrame, code, totalSteps }: StepInspectorProps) {
  const codeLines = useMemo(() => code.split('\\n'), [code]);
  const currentLine = codeLines[frame.line - 1]?.trim() || '';

  // Get all local vars from the top stack frame
  const topFrame = frame.stack?.[frame.stack.length - 1];
  const prevTopFrame = prevFrame?.stack?.[prevFrame.stack.length - 1];
  const vars = topFrame?.localVars || {};
  const prevVars = prevTopFrame?.localVars || {};

  // Find arrays in the heap
  const arrays = useMemo(() => {
    const result: { addr: string; name: string; items: any[]; prevItems?: any[] }[] = [];
    const heap = frame.heap || {};
    const prevHeap = prevFrame?.heap || {};

    // Find variable names that reference arrays
    for (const [name, val] of Object.entries(vars)) {
      if (typeof val === 'string' && val.startsWith('ref:')) {
        const addr = val.slice(4);
        const node = heap[addr];
        if (node?.type === 'array' && node.items) {
          const prevNode = prevHeap[addr];
          result.push({ addr, name, items: node.items, prevItems: prevNode?.items });
        }
      }
    }

    // Also find unnamed arrays
    for (const [addr, node] of Object.entries(heap)) {
      if (node.type === 'array' && node.items && !result.find(r => r.addr === addr)) {
        const prevNode = prevHeap[addr];
        result.push({ addr, name: 'array', items: node.items, prevItems: prevNode?.items });
      }
    }
    return result;
  }, [frame, prevFrame]);

  // Find objects in the heap
  const objects = useMemo(() => {
    const result: { addr: string; name: string; fields: Record<string, any>; type: string }[] = [];
    const heap = frame.heap || {};
    for (const [addr, node] of Object.entries(heap)) {
      if (node.type === 'object' && node.fields) {
        // Find name from vars
        let name = 'object';
        for (const [vName, val] of Object.entries(vars)) {
          if (typeof val === 'string' && val === 'ref:' + addr) { name = vName; break; }
        }
        result.push({ addr, name, fields: node.fields, type: node.type });
      }
    }
    return result;
  }, [frame, vars]);

  // Detect which variables changed
  const changedVars = useMemo(() => {
    const changed = new Set<string>();
    for (const [name, val] of Object.entries(vars)) {
      if (JSON.stringify(val) !== JSON.stringify(prevVars[name])) {
        changed.add(name);
      }
    }
    return changed;
  }, [vars, prevVars]);

  // Detect array element changes (swaps, modifications)
  const arrayChanges = useMemo(() => {
    const changes: { arrayName: string; changedIndices: number[]; swapPair?: [number, number] }[] = [];
    for (const arr of arrays) {
      if (!arr.prevItems) continue;
      const changedIndices: number[] = [];
      for (let idx = 0; idx < arr.items.length; idx++) {
        if (arr.items[idx] !== arr.prevItems[idx]) changedIndices.push(idx);
      }
      // Detect swap: exactly 2 changed and values cross
      let swapPair: [number, number] | undefined;
      if (changedIndices.length === 2) {
        const [a, b] = changedIndices;
        if (arr.items[a] === arr.prevItems[b] && arr.items[b] === arr.prevItems[a]) {
          swapPair = [a, b];
        }
      }
      if (changedIndices.length > 0) {
        changes.push({ arrayName: arr.name, changedIndices, swapPair });
      }
    }
    return changes;
  }, [arrays]);

  // Find pointer variables (integers that could be array indices)
  const pointers = useMemo(() => {
    const ptrs: { name: string; value: number }[] = [];
    if (arrays.length === 0) return ptrs;
    const maxLen = Math.max(...arrays.map(a => a.items.length));
    for (const [name, val] of Object.entries(vars)) {
      if (typeof val === 'number' && Number.isInteger(val) && val >= 0 && val < maxLen) {
        if (INDEX_NAMES.has(name) || name.includes('idx') || name.includes('index') || name.includes('Index')) {
          ptrs.push({ name, value: val });
        }
      }
    }
    return ptrs;
  }, [vars, arrays]);

  // Auto-generate explanation
  const explanation = useMemo(() => {
    const parts: string[] = [];

    // Variable changes
    const varChanges = Array.from(changedVars)
      .filter(n => !n.startsWith('ref:') && typeof vars[n] !== 'string' || !String(vars[n]).startsWith('ref:'));
    if (varChanges.length > 0) {
      for (const name of varChanges) {
        if (prevVars[name] !== undefined) {
          parts.push(name + ' changed from ' + JSON.stringify(prevVars[name]) + ' to ' + JSON.stringify(vars[name]));
        } else {
          parts.push(name + ' = ' + JSON.stringify(vars[name]));
        }
      }
    }

    // Array swap
    for (const change of arrayChanges) {
      if (change.swapPair) {
        const [a, b] = change.swapPair;
        const arr = arrays.find(x => x.name === change.arrayName);
        if (arr) parts.push('Swapped ' + change.arrayName + '[' + a + ']=' + arr.prevItems![a] + ' ↔ ' + change.arrayName + '[' + b + ']=' + arr.prevItems![b]);
      } else if (change.changedIndices.length > 0) {
        parts.push(change.arrayName + ' modified at index ' + change.changedIndices.join(', '));
      }
    }

    return parts;
  }, [changedVars, arrayChanges, vars, prevVars, arrays]);

  // Determine comparison from code line
  const comparisonInfo = useMemo(() => {
    const line = currentLine;
    if (line.includes('if ') || line.includes('while ')) {
      const match = line.match(/(if|while)\\s*[\\(]?(.+?)[\\)]?\\s*[:{{]/);
      if (match) return match[2].trim();
      // fallback: just get everything after if/while
      const idx = line.indexOf('if ') >= 0 ? line.indexOf('if ') + 3 : line.indexOf('while ') + 6;
      return line.slice(idx).replace(/[:{()]/g, '').trim();
    }
    return null;
  }, [currentLine]);

  // Determine if line has a for loop
  const loopInfo = useMemo(() => {
    if (currentLine.includes('for ')) return currentLine;
    return null;
  }, [currentLine]);

  return (
    <div className="h-full flex flex-col overflow-y-auto" style={{ scrollbarWidth: 'thin' }}>

      {/* ─── Step Header ─── */}
      <div className="px-4 py-3 border-b border-zinc-800 bg-zinc-900/80 flex items-center justify-between shrink-0">
        <div className="flex items-center gap-2">
          <div className="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-xs font-bold">
            {frame.step}
          </div>
          <div>
            <div className="text-xs font-semibold text-zinc-200">Step {frame.step}</div>
            <div className="text-[10px] text-zinc-500 font-mono">Line {frame.line}</div>
          </div>
        </div>
        <div className="text-[10px] text-zinc-600">{frame.step} / {totalSteps}</div>
      </div>

      {/* ─── Current Code Line ─── */}
      <div className="px-4 py-3 border-b border-zinc-800/50 shrink-0">
        <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Current Line</div>
        <div className="bg-zinc-800/60 rounded-lg px-3 py-2 font-mono text-xs text-indigo-300 border-l-3 border-indigo-500" style={{ borderLeftWidth: '3px' }}>
          <span className="text-zinc-600 mr-3">{frame.line}</span>
          {currentLine || '—'}
        </div>
      </div>

      {/* ─── Comparison Result ─── */}
      {comparisonInfo && (
        <div className="px-4 py-2.5 border-b border-zinc-800/50 shrink-0">
          <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Condition Check</div>
          <div className="bg-zinc-800/40 rounded-lg px-3 py-2 font-mono text-xs text-amber-300 border-l-3 border-amber-500" style={{ borderLeftWidth: '3px' }}>
            {comparisonInfo}
          </div>
        </div>
      )}

      {/* ─── Variable State Table ─── */}
      <div className="px-4 py-3 border-b border-zinc-800/50 shrink-0">
        <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Variables</div>
        <div className="space-y-0.5">
          {Object.entries(vars)
            .filter(([_, v]) => typeof v !== 'string' || !String(v).startsWith('ref:'))
            .map(([name, val]) => {
              const changed = changedVars.has(name);
              return (
                <motion.div
                  key={name}
                  className={\`flex items-center gap-2 px-2.5 py-1.5 rounded-md text-xs font-mono \${
                    changed ? 'bg-amber-500/10 border border-amber-500/20' : 'bg-zinc-800/30'
                  }\`}
                  animate={changed ? { scale: [1, 1.02, 1] } : {}}
                  transition={{ duration: 0.3 }}
                >
                  <span className="text-purple-400 font-semibold w-20 shrink-0 truncate">{name}</span>
                  <span className="text-zinc-600">=</span>
                  <span className={\`\${changed ? 'text-amber-300 font-bold' : 'text-zinc-300'}\`}>
                    {JSON.stringify(val)}
                  </span>
                  {changed && prevVars[name] !== undefined && (
                    <span className="text-zinc-600 text-[10px] ml-auto">
                      was {JSON.stringify(prevVars[name])}
                    </span>
                  )}
                </motion.div>
              );
            })}
          {Object.keys(vars).filter(k => typeof vars[k] !== 'string' || !String(vars[k]).startsWith('ref:')).length === 0 && (
            <div className="text-xs text-zinc-600 italic py-2">No variables in scope</div>
          )}
        </div>
      </div>

      {/* ─── Array Visualizations ─── */}
      {arrays.map((arr) => {
        const change = arrayChanges.find(c => c.arrayName === arr.name);
        return (
          <div key={arr.addr} className="px-4 py-3 border-b border-zinc-800/50">
            <div className="flex items-center gap-2 mb-3">
              <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">{arr.name}</div>
              <div className="text-[10px] px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-400 font-mono">
                len={arr.items.length}
              </div>
              {change?.swapPair && (
                <div className="text-[10px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 font-bold ml-auto">
                  ⇄ SWAP
                </div>
              )}
            </div>

            {/* Pointer arrows row */}
            {pointers.length > 0 && (
              <div className="flex gap-1 mb-1 justify-center">
                {arr.items.map((_: any, idx: number) => {
                  const ptrsHere = pointers.filter(p => p.value === idx);
                  return (
                    <div key={idx} className="flex flex-col items-center" style={{ width: '48px' }}>
                      {ptrsHere.length > 0 ? (
                        <>
                          <div className="flex gap-0.5 flex-wrap justify-center">
                            {ptrsHere.map(p => (
                              <span key={p.name} className="text-[8px] font-bold px-1.5 py-0.5 rounded bg-indigo-500/30 text-indigo-300 font-mono">
                                {p.name}
                              </span>
                            ))}
                          </div>
                          <span className="text-indigo-400 text-xs leading-none">↓</span>
                        </>
                      ) : (
                        <div style={{ height: '24px' }} />
                      )}
                    </div>
                  );
                })}
              </div>
            )}

            {/* Array boxes */}
            <div className="flex gap-1 justify-center flex-wrap">
              <AnimatePresence>
                {arr.items.map((item: any, idx: number) => {
                  const isChanged = change?.changedIndices.includes(idx);
                  const isSwap = change?.swapPair?.includes(idx);
                  const hasPointer = pointers.some(p => p.value === idx);

                  let boxClass = 'bg-blue-500/10 border-blue-500/30 text-blue-300'; // unsorted default
                  if (isSwap) boxClass = 'bg-amber-500/15 border-amber-400/50 text-amber-300 border-dashed';
                  else if (isChanged) boxClass = 'bg-red-500/15 border-red-400/50 text-red-300 border-dashed';
                  else if (hasPointer) boxClass = 'bg-purple-500/10 border-purple-400/40 text-purple-300';

                  return (
                    <motion.div
                      key={idx}
                      className={\`w-12 h-12 flex flex-col items-center justify-center rounded-lg border-2 font-mono text-sm font-bold \${boxClass}\`}
                      animate={isChanged ? { scale: [1, 1.15, 1] } : {}}
                      transition={{ duration: 0.3, type: 'spring' }}
                    >
                      <span>{typeof item === 'object' ? '…' : item}</span>
                      <span className="text-[8px] text-zinc-600 font-normal">[{idx}]</span>
                    </motion.div>
                  );
                })}
              </AnimatePresence>
            </div>

            {/* Swap arrows indicator */}
            {change?.swapPair && (
              <div className="flex items-center justify-center gap-2 mt-2">
                <span className="text-[10px] font-mono text-amber-400">
                  [{change.swapPair[0]}]={arr.prevItems?.[change.swapPair[0]]}
                </span>
                <span className="text-amber-500 font-bold">⇄</span>
                <span className="text-[10px] font-mono text-amber-400">
                  [{change.swapPair[1]}]={arr.prevItems?.[change.swapPair[1]]}
                </span>
              </div>
            )}
          </div>
        );
      })}

      {/* ─── Object Visualizations ─── */}
      {objects.map(obj => (
        <div key={obj.addr} className="px-4 py-3 border-b border-zinc-800/50">
          <div className="flex items-center gap-2 mb-2">
            <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">{obj.name}</div>
            <div className="text-[10px] px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-400 font-mono">object</div>
          </div>
          <div className="space-y-1">
            {Object.entries(obj.fields).map(([key, val]) => (
              <div key={key} className="flex items-center gap-2 px-2.5 py-1 rounded-md bg-zinc-800/30 text-xs font-mono">
                <span className="text-cyan-400 font-semibold">.{key}</span>
                <span className="text-zinc-600">=</span>
                <span className="text-zinc-300">{JSON.stringify(val)}</span>
              </div>
            ))}
          </div>
        </div>
      ))}

      {/* ─── Auto Explanation ─── */}
      {explanation.length > 0 && (
        <div className="px-4 py-3 border-b border-zinc-800/50 shrink-0">
          <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">What Happened</div>
          <div className="space-y-1">
            {explanation.map((text, i) => (
              <div key={i} className="text-xs text-zinc-400 leading-relaxed flex items-start gap-2">
                <span className="text-emerald-500 mt-0.5">›</span>
                <span>{text}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ─── Call Stack ─── */}
      <div className="px-4 py-3 shrink-0">
        <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Call Stack</div>
        <div className="space-y-1">
          {(frame.stack || []).map((entry, i) => (
            <div key={i} className="flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-zinc-800/30 text-xs">
              <span className="text-indigo-400 font-mono font-semibold">{entry.funcName || 'main'}()</span>
              <span className="text-zinc-600 ml-auto font-mono">:{entry.line || frame.line}</span>
            </div>
          ))}
        </div>
      </div>

      {/* ─── Stdout ─── */}
      {frame.stdout && (
        <div className="px-4 py-3 border-t border-zinc-800/50 shrink-0">
          <div className="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-2">Program Output</div>
          <pre className="text-xs text-emerald-400 font-mono bg-zinc-800/40 rounded-lg p-2.5 whitespace-pre-wrap">{frame.stdout}</pre>
        </div>
      )}
    </div>
  );
}
`);

// ═══════════════════════════════════════════════════════════════
// 2. UPDATED PAGE.TSX — Use StepInspector instead of MemoryCanvas
// ═══════════════════════════════════════════════════════════════
w('src/app/page.tsx', \`'use client';

import React, { useState, useRef, useCallback, useEffect } from 'react';
import dynamic from 'next/dynamic';
import { Play, SkipBack, SkipForward, Pause, Loader2, Terminal, Keyboard, Zap } from 'lucide-react';

const CodeEditor = dynamic(() => import('@/components/CodeEditor'), { ssr: false });
const StepInspector = dynamic(() => import('@/components/StepInspector'), { ssr: false });

// ─── Types ───
interface StackEntry { funcName: string; localVars: Record<string, any>; line: number; }
interface HeapNode { type: string; value?: any; items?: any[]; fields?: Record<string, any>; pointsTo?: string; }
interface StateFrame { step: number; line: number; stack: StackEntry[]; heap: Record<string, HeapNode>; stdout: string; }

// ─── Default code samples ───
const SAMPLES: Record<string, string> = {
  python: \\\`# Selection Sort in Python
def selection_sort(arr):
    n = len(arr)
    for i in range(n):
        min_index = i
        for j in range(i + 1, n):
            if arr[j] < arr[min_index]:
                min_index = j
        arr[i], arr[min_index] = arr[min_index], arr[i]

data = [29, 10, 14, 37, 13]
selection_sort(data)
print("Sorted:", data)
\\\`,
  java: \\\`public class Main {
    public static void main(String[] args) {
        int[] arr = {29, 10, 14, 37, 13};

        // Selection sort
        for (int i = 0; i < arr.length - 1; i++) {
            int minIdx = i;
            for (int j = i + 1; j < arr.length; j++) {
                if (arr[j] < arr[minIdx]) {
                    minIdx = j;
                }
            }
            int temp = arr[i];
            arr[i] = arr[minIdx];
            arr[minIdx] = temp;
        }
        System.out.println("Sorted");
    }
}
\\\`,
  c: \\\`#include <stdio.h>

int main() {
    int arr[] = {29, 10, 14, 37, 13};
    int n = 5;

    for (int i = 0; i < n - 1; i++) {
        int min_index = i;
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[min_index]) {
                min_index = j;
            }
        }
        int temp = arr[i];
        arr[i] = arr[min_index];
        arr[min_index] = temp;
    }
    printf("Sorted\\\\n");
    return 0;
}
\\\`
};

type Lang = 'python' | 'java' | 'c';
type Status = 'idle' | 'running' | 'done' | 'error';

export default function Home() {
  const [language, setLanguage] = useState<Lang>('python');
  const [code, setCode] = useState(SAMPLES.python);
  const [stdin, setStdin] = useState('');
  const [consoleOutput, setConsoleOutput] = useState('');
  const [status, setStatus] = useState<Status>('idle');
  const [frames, setFrames] = useState<StateFrame[]>([]);
  const [currentStep, setCurrentStep] = useState(0);
  const [isPlaying, setIsPlaying] = useState(false);
  const playRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const frame = frames[currentStep] ?? null;
  const prevFrame = currentStep > 0 ? frames[currentStep - 1] : null;
  const canPrev = currentStep > 0;
  const canNext = currentStep < frames.length - 1;

  const handleLangChange = (lang: Lang) => {
    setLanguage(lang);
    setCode(SAMPLES[lang]);
    resetState();
  };

  const resetState = () => {
    setFrames([]); setCurrentStep(0); setConsoleOutput('');
    setStatus('idle'); setIsPlaying(false);
    if (playRef.current) clearInterval(playRef.current);
  };

  const handleVisualize = useCallback(() => {
    resetState();
    setStatus('running');
    setConsoleOutput('Connecting to server...\\\\n');

    const ws = new WebSocket('ws://localhost:8080');

    ws.onopen = () => {
      setConsoleOutput(prev => prev + 'Connected. Sending code...\\\\n');
      ws.send(JSON.stringify({ type: 'EXECUTE', language, code, stdin }));
    };

    ws.onmessage = (event) => {
      const msg = JSON.parse(event.data);
      if (msg.type === 'STATUS') {
        setConsoleOutput(prev => prev + 'Status: ' + msg.status + '\\\\n');
      } else if (msg.type === 'RESULT') {
        if (msg.success && msg.frames?.length) {
          setFrames(msg.frames);
          setCurrentStep(0);
          const lastFrame = msg.frames[msg.frames.length - 1];
          setConsoleOutput(prev => prev + 'Execution complete. ' + msg.frames.length + ' steps captured.\\\\n' +
            (lastFrame.stdout ? '─── Program Output ───\\\\n' + lastFrame.stdout : ''));
          setStatus('done');
        } else {
          setConsoleOutput(prev => prev + 'Error: ' + (msg.output || 'Unknown error') + '\\\\n');
          setStatus('error');
        }
        ws.close();
      } else if (msg.type === 'ERROR') {
        setConsoleOutput(prev => prev + 'Server error: ' + msg.message + '\\\\n');
        setStatus('error');
        ws.close();
      }
    };

    ws.onerror = () => {
      setConsoleOutput(prev => prev + 'WebSocket connection failed. Is the backend running on port 8080?\\\\n');
      setStatus('error');
    };
  }, [language, code, stdin]);

  // Playback
  const handleNext = () => { if (canNext) setCurrentStep(s => s + 1); };
  const handlePrev = () => { if (canPrev) setCurrentStep(s => s - 1); };
  const handlePlay = () => {
    if (!canNext) return;
    setIsPlaying(true);
    playRef.current = setInterval(() => {
      setCurrentStep(s => {
        if (s >= frames.length - 1) { clearInterval(playRef.current!); setIsPlaying(false); return s; }
        return s + 1;
      });
    }, 500);
  };
  const handlePause = () => { setIsPlaying(false); if (playRef.current) clearInterval(playRef.current); };

  const isFetching = status === 'running';

  return (
    <div className="h-screen w-screen flex flex-col overflow-hidden bg-zinc-950">
      {/* ─── Top Bar ─── */}
      <header className="h-11 flex items-center justify-between px-4 bg-zinc-900/80 border-b border-zinc-800 shrink-0 backdrop-blur-sm">
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-1.5">
            <Zap className="w-4 h-4 text-indigo-400" />
            <h1 className="text-sm font-extrabold tracking-wide bg-gradient-to-r from-indigo-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">
              AlgoViz
            </h1>
          </div>
          <div className="h-4 w-px bg-zinc-700" />
          <div className="flex gap-1">
            {(['python','java','c'] as Lang[]).map(lang => (
              <button key={lang} onClick={() => handleLangChange(lang)}
                className={\\\`px-3 py-1 text-xs font-medium rounded-md transition-all \\\${
                  language === lang
                    ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-500/20'
                    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800'
                }\\\`}>
                {lang === 'c' ? 'C' : lang.charAt(0).toUpperCase() + lang.slice(1)}
              </button>
            ))}
          </div>
        </div>
        <div className="flex items-center gap-3 text-xs text-zinc-500">
          {status === 'running' && <><Loader2 className="w-3.5 h-3.5 animate-spin text-indigo-400" /><span>Executing...</span></>}
          {status === 'done' && frames.length > 0 && (
            <span className="text-zinc-400 font-mono">
              Step {currentStep + 1}/{frames.length}
              {frame?.line ? \\\` · Line \\\${frame.line}\\\` : ''}
            </span>
          )}
        </div>
      </header>

      {/* ─── Main 3-Panel Layout ─── */}
      <div className="flex-1 flex overflow-hidden">

        {/* Panel 1: I/O Hub */}
        <div className="w-64 shrink-0 flex flex-col border-r border-zinc-800 bg-zinc-900/40">
          <div className="flex flex-col h-1/2 border-b border-zinc-800">
            <div className="flex items-center gap-2 px-3 py-2 border-b border-zinc-800/50 shrink-0">
              <Keyboard className="w-3.5 h-3.5 text-indigo-400" />
              <span className="text-[10px] font-bold text-zinc-500 uppercase tracking-wider">Custom Input (stdin)</span>
            </div>
            <textarea value={stdin} onChange={(e) => setStdin(e.target.value)}
              placeholder="Enter stdin here..."
              className="flex-1 resize-none bg-transparent text-xs text-zinc-300 p-3 font-mono placeholder:text-zinc-700 focus:outline-none"
              spellCheck={false} />
          </div>
          <div className="flex flex-col flex-1 min-h-0">
            <div className="flex items-center gap-2 px-3 py-2 border-b border-zinc-800/50 shrink-0">
              <Terminal className="w-3.5 h-3.5 text-emerald-400" />
              <span className="text-[10px] font-bold text-zinc-500 uppercase tracking-wider">Console Output</span>
            </div>
            <pre className="flex-1 overflow-auto text-[11px] text-zinc-400 p-3 font-mono leading-relaxed whitespace-pre-wrap">
              {consoleOutput || 'Output will appear here...'}
            </pre>
          </div>
        </div>

        {/* Panel 2: Editor */}
        <div className="flex-1 flex flex-col min-w-0 relative">
          <div className="flex-1 min-h-0">
            <CodeEditor code={code} language={language === 'c' ? 'c' : language} onChange={(v) => setCode(v || '')} activeLine={frame?.line} />
          </div>
          {/* Floating Action Bar */}
          <div className="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 p-1.5 bg-zinc-900/90 backdrop-blur-xl border border-zinc-700/60 rounded-full shadow-2xl shadow-black/50 z-30">
            <button onClick={handlePrev} disabled={!canPrev || isFetching}
              className="p-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition disabled:opacity-30" title="Previous Step">
              <SkipBack className="w-4 h-4" />
            </button>
            {isPlaying ? (
              <button onClick={handlePause} className="p-2 rounded-full text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 transition" title="Pause">
                <Pause className="w-4 h-4" />
              </button>
            ) : (
              <button onClick={handlePlay} disabled={!canNext || isFetching}
                className="p-2 rounded-full text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 transition disabled:opacity-30" title="Play">
                <Play className="w-4 h-4" />
              </button>
            )}
            <button onClick={handleNext} disabled={!canNext || isFetching}
              className="p-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition disabled:opacity-30" title="Next Step">
              <SkipForward className="w-4 h-4" />
            </button>
            <div className="w-px h-6 bg-zinc-700 mx-1" />
            <button onClick={handleVisualize} disabled={isFetching}
              className="flex items-center gap-2 px-5 py-1.5 rounded-full bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-500 transition-all disabled:opacity-50 shadow-lg shadow-indigo-600/25">
              {isFetching ? (<><Loader2 className="w-4 h-4 animate-spin" /><span>Running...</span></>) : (<span>▶ Visualize</span>)}
            </button>
          </div>
        </div>

        {/* Panel 3: Step Inspector */}
        <div className="w-[440px] shrink-0 flex flex-col border-l border-zinc-800 bg-zinc-900/30">
          {frame ? (
            <StepInspector frame={frame} prevFrame={prevFrame} code={code} totalSteps={frames.length} />
          ) : (
            <div className="h-full flex items-center justify-center text-zinc-600 text-sm">
              <div className="text-center space-y-3 px-8">
                <div className="text-5xl">🔬</div>
                <p className="font-semibold text-zinc-400">Step Inspector</p>
                <p className="text-xs text-zinc-600 leading-relaxed">
                  Write code, hit <strong>Visualize</strong>, then step through to see variables, arrays, pointers, comparisons, and swaps — all in real time.
                </p>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
\`);

console.log('\\n✅ All visualization components rebuilt!');
console.log('The app will hot-reload automatically.');
